#!/usr/bin/env bash
# cc-huoshan1-ds4pro — Run Claude Code against Volcengine DeepSeek V4 Pro
# Uses litellm as a local proxy to translate Anthropic Messages ↔ OpenAI Chat Completions
#
# Required env: API_KEY_HUOSHAN_PLAN_1
# Optional env: HUOSHAN_BASE_URL (default: https://ark.cn-beijing.volces.com/api/v3)
#               HUOSHAN_MODEL    (default: deepseek-v4-0324)
#               LITELLM_PORT     (default: 4100)

set -euo pipefail

: "${API_KEY_HUOSHAN_PLAN_1:?环境变量 API_KEY_HUOSHAN_PLAN_1 未设置}"

HUOSHAN_BASE_URL="${HUOSHAN_BASE_URL:-https://ark.cn-beijing.volces.com/api/v3}"
HUOSHAN_MODEL="${HUOSHAN_MODEL:-deepseek-v4-0324}"
PORT="${LITELLM_PORT:-4100}"

cleanup() {
  if [[ -n "${PROXY_PID:-}" ]]; then
    kill "$PROXY_PID" 2>/dev/null || true
    wait "$PROXY_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# Start litellm proxy (translates Anthropic format → OpenAI format → Volcengine)
litellm --model "openai/${HUOSHAN_MODEL}" \
  --api_base "$HUOSHAN_BASE_URL" \
  --api_key "$API_KEY_HUOSHAN_PLAN_1" \
  --port "$PORT" \
  --drop_params \
  --num_workers 1 \
  > /tmp/litellm-huoshan1.log 2>&1 &
PROXY_PID=$!

# Wait for proxy to be ready
for i in $(seq 1 20); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

if ! curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
  echo "ERROR: litellm proxy failed to start. Check /tmp/litellm-huoshan1.log" >&2
  exit 1
fi

# Run Claude Code pointing at local proxy
export ANTHROPIC_BASE_URL="http://localhost:${PORT}"
export ANTHROPIC_API_KEY="sk-litellm-proxy"
export ANTHROPIC_MODEL="openai/${HUOSHAN_MODEL}"

exec claude "$@"
