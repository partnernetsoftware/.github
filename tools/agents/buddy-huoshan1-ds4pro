#!/usr/bin/env bash
# buddy-huoshan1-ds4pro — CodeBuddy 直连火山引擎 Coding Plan
# 火山引擎 /api/coding/v3 提供 OpenAI Chat Completions 兼容接口
#
# Required env: API_KEY_HUOSHAN_PLAN_1
# Optional env: HUOSHAN_MODEL (default: deepseek-v3.2)

set -euo pipefail

: "${API_KEY_HUOSHAN_PLAN_1:?环境变量 API_KEY_HUOSHAN_PLAN_1 未设置}"

HUOSHAN_MODEL="${HUOSHAN_MODEL:-deepseek-v3.2}"

# Generate models.json for CodeBuddy
MODELS_DIR="$HOME/.codebuddy"
mkdir -p "$MODELS_DIR"

cat > "${MODELS_DIR}/models.json" <<EOF
{
  "models": [
    {
      "id": "${HUOSHAN_MODEL}",
      "name": "DeepSeek V3.2 (Volcengine Coding Plan)",
      "vendor": "Volcengine",
      "url": "https://ark.cn-beijing.volces.com/api/coding/v3/chat/completions",
      "apiKey": "${API_KEY_HUOSHAN_PLAN_1}",
      "maxInputTokens": 128000,
      "maxOutputTokens": 8192,
      "supportsToolCall": true,
      "supportsImages": false
    }
  ],
  "availableModels": [
    "${HUOSHAN_MODEL}"
  ]
}
EOF

exec codebuddy --model "${HUOSHAN_MODEL}" "$@"
