{
  "_note": "Canonical copy: workers/mcp-cf-bots/mcp.recommended.json",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "mcp-cf-bots": {
      "url": "${env:MCP_CF_BOTS_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MCP_CF_BOTS_TOKEN}"
      }
    }
  }
}
