{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "mcp-cf-bots": {
      "url": "https://mcp-cf-bots.kcc668.workers.dev/mcp",
