{
  "name": "tauri-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "worker:once": "cargo run --manifest-path src-tauri/Cargo.toml -- --worker-once",
    "headless:probe": "cargo run --manifest-path src-tauri/Cargo.toml -- --headless-probe",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
