FROM ubuntu:24.04

ARG COSMOCC_VERSION=4.0.2
ARG ZIG_VERSION=0.16.0
ARG BUN_VERSION=latest

ENV DEBIAN_FRONTEND=noninteractive

# Base build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    unzip \
    git \
    ca-certificates \
    xz-utils \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ── cosmocc (Cosmopolitan cross-compiler) ──
RUN mkdir -p /opt/cosmocc && \
    curl -fSL "https://cosmo.zip/pub/cosmocc/cosmocc-${COSMOCC_VERSION}.zip" -o /tmp/cosmocc.zip && \
    unzip -q /tmp/cosmocc.zip -d /opt/cosmocc && \
    rm /tmp/cosmocc.zip
ENV PATH="/opt/cosmocc/bin:${PATH}"

# ── Zig ──
RUN curl -fSL "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" -o /tmp/zig.tar.xz && \
    tar -xJf /tmp/zig.tar.xz -C /opt && \
    mv /opt/zig-x86_64-linux-${ZIG_VERSION} /opt/zig && \
    rm /tmp/zig.tar.xz
ENV PATH="/opt/zig:${PATH}"

# ── Rust (via rustup) ──
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# ── Bun ──
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Verify all toolchains
RUN cosmocc --version && \
    zig version && \
    rustc --version && cargo --version && \
    bun --version

WORKDIR /workspace

CMD ["bash"]
