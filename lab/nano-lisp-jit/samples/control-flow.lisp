; Control-flow smoke: exercise block grouping plus taken/not-taken boolean branches.
(module
  (main
    (block
      (bool true)
      (branch taken)
      (u64 1)
      (expect 999)
      (label taken)
      (i64 -7)
      (expect -7)
      (eq-i64 -7)
      (branch eq-taken)
      (u64 1)
      (expect 999)
      (label eq-taken)
      (i64 -8)
      (lt-i64 -7)
      (branch lt-taken)
      (u64 1)
      (expect 999)
      (label lt-taken)
      (i64 9)
      (gt-i64 8)
      (branch gt-taken)
      (u64 1)
      (expect 999)
      (label gt-taken))
    (block
      (bool false)
      (branch skipped)
      (u64 42)
      (expect 42)
      (bool true)
      (branch done)
      (label skipped)
      (u64 1)
      (expect 999)
      (label done)
      (bool true)
      (expect true))))
