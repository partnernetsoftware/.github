; Explicit mutable pointer smoke for VM, AOT, codegen, and object memory access.
(module
  (const word "Az09")
  (main
    (const-ptr word)
    (expect nonnull)
    (const-ptr word)
    (load-u8)
    (expect 65)
    (const-ptr word)
    (load-u16)
    (expect 31297)
    (const-ptr word)
    (load-u32)
    (expect 959478337)
    (const-ptr word)
    (add-ptr 1)
    (load-u8)
    (expect 122)
    (mut-ptr word)
    (store-u8 66)
    (load-u8)
    (expect 66)
    (mut-ptr word)
    (store-u16 17218)
    (load-u16)
    (expect 17218)
    (mut-ptr word)
    (store-u32 1145258561)
    (load-u32)
    (expect 1145258561)
    (bool false)
    (not-bool)
    (expect true)))
