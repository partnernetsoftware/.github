; Typed value smoke: signed integer, bool, and pointer result from resolve.
(module
  (import strlen "libc" "strlen" "u64(ptr)")
  (main
    (i64 -42)
    (expect -42)
    (bool true)
    (expect true)
    (bool false)
    (not-bool)
    (expect true)
    (and-bool false)
    (expect false)
    (or-bool true)
    (expect true)
    (null-ptr)
    (expect null)
    (is-null-ptr)
    (expect true)
    (null-ptr)
    (add-ptr 8)
    (expect nonnull)
    (is-nonnull-ptr)
    (expect true)
    (resolve strlen)
    (expect nonnull)
    (is-nonnull-ptr)
    (expect true)))
